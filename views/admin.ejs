<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h2 class="fw-extrabold text-dark mb-1 d-flex align-items-center gap-2">
      <i class="fas fa-user-shield text-teal" style="color: #14b8a6;"></i>
      <span>Administrator Control Panel</span>
    </h2>
    <p class="text-muted small mb-0">Platform overview, user management, and clinical AI model configuration.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/users" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1.5">
      <i class="fas fa-users"></i> Manage Users
    </a>
    <a href="/admin/training" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1.5 shadow-sm">
      <i class="fas fa-cogs"></i> Model & Training Hub
    </a>
  </div>
</div>

<!-- Admin Stats Cards Grid -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card h-100 shadow-sm border-0 stat-card-primary">
      <div class="card-body p-3 d-flex align-items-center gap-3">
        <div class="stat-icon-wrapper bg-primary-subtle text-primary">
          <i class="fas fa-users"></i>
        </div>
        <div>
          <span class="text-secondary extra-small fw-bold text-uppercase d-block">Registered Users</span>
          <h4 class="fw-extrabold text-dark mb-0"><%= (typeof stats !== 'undefined' && stats.users) || totalUsers || 0 %></h4>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card h-100 shadow-sm border-0 stat-card-success">
      <div class="card-body p-3 d-flex align-items-center gap-3">
        <div class="stat-icon-wrapper bg-success-subtle text-success">
          <i class="fas fa-lungs"></i>
        </div>
        <div>
          <span class="text-secondary extra-small fw-bold text-uppercase d-block">Total X-Rays Analyzed</span>
          <h4 class="fw-extrabold text-dark mb-0"><%= (typeof stats !== 'undefined' && stats.scans) || totalScans || 0 %></h4>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card h-100 shadow-sm border-0 stat-card-danger">
      <div class="card-body p-3 d-flex align-items-center gap-3">
        <div class="stat-icon-wrapper bg-danger-subtle text-danger">
          <i class="fas fa-virus"></i>
        </div>
        <div>
          <span class="text-secondary extra-small fw-bold text-uppercase d-block">Pneumonia Positives</span>
          <h4 class="fw-extrabold text-danger mb-0"><%= (typeof stats !== 'undefined' && stats.pneumoniaDetected) || pneumoniaDetected || 0 %></h4>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card h-100 shadow-sm border-0 stat-card-warning">
      <div class="card-body p-3 d-flex align-items-center gap-3">
        <div class="stat-icon-wrapper bg-warning-subtle text-warning">
          <i class="fas fa-comments"></i>
        </div>
        <div>
          <span class="text-secondary extra-small fw-bold text-uppercase d-block">Pending Feedback</span>
          <h4 class="fw-extrabold text-warning mb-0"><%= (typeof stats !== 'undefined' && stats.pendingFeedback) || pendingFeedback || 0 %></h4>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <!-- Recent Activity Logs Table -->
  <div class="col-lg-7">
    <div class="card shadow-sm border-0 h-100 overflow-hidden">
      <div class="card-header py-3 bg-dark text-white d-flex align-items-center justify-content-between">
        <h6 class="mb-0 fw-bold d-flex align-items-center gap-2">
          <i class="fas fa-list-alt text-teal" style="color: #14b8a6;"></i>
          <span>Recent System Activity</span>
        </h6>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 extra-small">
            <thead class="table-light text-uppercase">
              <tr>
                <th class="ps-3">User</th>
                <th>Action</th>
                <th>IP Address</th>
                <th>Timestamp</th>
              </tr>
            </thead>
            <tbody>
              <% if(typeof recentLogs !== 'undefined' && recentLogs && recentLogs.length > 0){ %>
                <% recentLogs.forEach(log => { %>
                  <tr>
                    <td class="ps-3 fw-bold text-dark"><%= log.userId ? log.userId.name : 'System/Guest' %></td>
                    <td><span class="badge bg-light text-secondary border"><%= log.action || log.activityType || 'Action' %></span></td>
                    <td class="text-muted"><%= log.ipAddress || '127.0.0.1' %></td>
                    <td class="text-muted"><%= new Date(log.createdAt || Date.now()).toLocaleTimeString() %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="4" class="text-center py-4 text-muted">No activity logs recorded yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- User Feedback Responses -->
  <div class="col-lg-5">
    <div class="card shadow-sm border-0 h-100 overflow-hidden">
      <div class="card-header py-3 bg-dark text-white d-flex align-items-center justify-content-between">
        <h6 class="mb-0 fw-bold d-flex align-items-center gap-2">
          <i class="fas fa-comment-dots text-teal" style="color: #14b8a6;"></i>
          <span>User Feedback Queue</span>
        </h6>
      </div>
      <div class="card-body p-3 d-flex flex-column gap-3">
        <% if(typeof feedbacks !== 'undefined' && feedbacks && feedbacks.length > 0){ %>
          <% feedbacks.forEach(f => { %>
            <div class="p-3 border rounded-3 bg-light">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-dark extra-small"><%= f.userId ? f.userId.name : 'User' %></span>
                <span class="badge bg-warning text-dark extra-small"><%= f.rating %> / 5 ★</span>
              </div>
              <p class="text-secondary extra-small mb-2"><%= f.comments %></p>
              
              <% if(f.adminResponse){ %>
                <div class="p-2 bg-white border rounded extra-small text-muted mb-2">
                  <strong>Response:</strong> <%= f.adminResponse %>
                </div>
              <% } else { %>
                <form action="/admin/feedback/<%= f._id %>/respond" method="POST">
                  <div class="input-group input-group-sm">
                    <input type="text" name="response" class="form-control" placeholder="Type reply..." required>
                    <button class="btn btn-primary" type="submit">Reply</button>
                  </div>
                </form>
              <% } %>
            </div>
          <% }) %>
        <% } else { %>
          <div class="text-center py-4 text-muted my-auto">
            <i class="fas fa-check-circle fs-3 mb-2 text-success"></i>
            <p class="mb-0 extra-small">All feedback has been reviewed</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>