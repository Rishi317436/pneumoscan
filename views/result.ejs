<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h2 class="fw-extrabold text-dark mb-1 d-flex align-items-center gap-2">
      <i class="fas fa-poll text-teal" style="color: #14b8a6;"></i>
      <span>Detection Results & Scan History</span>
    </h2>
    <p class="text-muted small mb-0">Dual-method pneumonia classification metrics and comparative agreements.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/comparison" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1.5">
      <i class="fas fa-balance-scale"></i> Dataset Comparison
    </a>
    <a href="/scan/upload" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1.5 shadow-sm">
      <i class="fas fa-plus"></i> New Analysis
    </a>
  </div>
</div>

<!-- Scans History Table -->
<div class="card shadow-sm border-0 mb-4 overflow-hidden">
  <div class="card-header py-3 bg-dark text-white d-flex align-items-center justify-content-between">
    <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
      <i class="fas fa-history" style="color: #14b8a6;"></i>
      <span>Recent Chest X-Ray Analyses</span>
    </h5>
    <span class="badge bg-teal-subtle text-teal border border-teal-subtle">
      <%= (typeof results !== 'undefined' && results) ? results.length : 0 %> Total Scans
    </span>
  </div>

  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark text-uppercase extra-small">
          <tr>
            <th class="ps-4">Scan File</th>
            <th>Traditional (DIP)</th>
            <th>Manual Score</th>
            <th>Deep Learning (ML)</th>
            <th>ML Confidence</th>
            <th>Agreement</th>
            <th>Date</th>
            <th class="text-end pe-4">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if(typeof results !== 'undefined' && results && results.length > 0){ %>
            <% results.forEach(r => { %>
            <tr>
              <td class="ps-4 fw-semibold text-dark">
                <i class="fas fa-file-image me-2 text-teal" style="color: #14b8a6;"></i>
                <%= r.scanId ? r.scanId.filename : (r.originalImage ? r.originalImage.split(/[\\\/]/).pop() : 'Chest_XRay.jpg') %>
              </td>
              <td>
                <% if(r.manualDetection && r.manualDetection.prediction === 'PNEUMONIA'){ %>
                  <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5"><i class="fas fa-exclamation-triangle me-1"></i> PNEUMONIA</span>
                <% } else if(r.manualDetection && r.manualDetection.prediction === 'NORMAL') { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5"><i class="fas fa-check-circle me-1"></i> NORMAL</span>
                <% } else { %>
                  <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5">N/A</span>
                <% } %>
              </td>
              <td>
                <span class="fw-bold text-dark"><%= r.manualDetection && typeof r.manualDetection.score === 'number' ? r.manualDetection.score.toFixed(1) + '%' : 'N/A' %></span>
              </td>
              <td>
                <% if(r.mlDetection && r.mlDetection.prediction === 'PNEUMONIA'){ %>
                  <span class="badge bg-danger text-white px-2.5 py-1.5"><i class="fas fa-robot me-1"></i> PNEUMONIA</span>
                <% } else if(r.mlDetection && r.mlDetection.prediction === 'NORMAL') { %>
                  <span class="badge bg-success text-white px-2.5 py-1.5"><i class="fas fa-robot me-1"></i> NORMAL</span>
                <% } else { %>
                  <span class="badge bg-secondary px-2.5 py-1.5">N/A</span>
                <% } %>
              </td>
              <td>
                <span class="fw-extrabold text-teal" style="color: #14b8a6;">
                  <%= r.mlDetection && typeof r.mlDetection.confidence === 'number' ? (r.mlDetection.confidence * (r.mlDetection.confidence <= 1 ? 100 : 1)).toFixed(1) + '%' : 'N/A' %>
                </span>
              </td>
              <td>
                <% if(r.comparison && r.comparison.agreementStatus === 'AGREE'){ %>
                  <span class="badge bg-success text-white px-2.5 py-1.5"><i class="fas fa-check-circle me-1"></i> AGREE</span>
                <% } else if(r.comparison && r.comparison.agreementStatus === 'DISAGREE') { %>
                  <span class="badge bg-warning text-dark px-2.5 py-1.5"><i class="fas fa-exclamation-triangle me-1"></i> DISAGREE</span>
                <% } else { %>
                  <span class="badge bg-light text-muted border px-2.5 py-1.5">-</span>
                <% } %>
              </td>
              <td class="text-secondary extra-small">
                <%= new Date(r.createdAt || Date.now()).toLocaleDateString() %>
              </td>
              <td class="text-end pe-4">
                <a href="/scan/detail/<%= r._id %>" class="btn btn-outline-primary btn-sm px-3 py-1">
                  View Detail &rarr;
                </a>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="fas fa-lungs mb-3 text-muted" style="font-size: 3rem;"></i>
                <p class="mb-0">No analysis results available yet. <a href="/scan/upload" class="fw-bold text-teal" style="color: #14b8a6;">Upload a Chest X-Ray to begin</a>.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>